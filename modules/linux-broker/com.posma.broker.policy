<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <!--
    Not installed by the app itself — a packaging concern, not runtime.

    `org.freedesktop.policykit.exec.path` below must match the installed
    binary EXACTLY, or pkexec silently falls back to the generic
    org.freedesktop.policykit.exec action instead of this one. It points at
    /opt/posma/linux-broker, which is where install-daemon.sh puts it. If
    you run a development build from somewhere else, either install the
    binary to that path or adjust this file locally — do not commit a local
    path back.

    Install: sudo install -Dm644 com.posma.broker.policy
      /usr/share/polkit-1/actions/com.posma.broker.policy

    Until installed, pkexec still works via the generic
    org.freedesktop.policykit.exec action (Access_plan.md §6 step 3's
    "działa najpierw" cut) — it just re-prompts every single call. Once
    installed, allow_active uses auth_admin_keep: polkit caches the admin
    auth for a short window (a few minutes of inactivity, agent-dependent)
    so the user isn't re-prompted on every action within a session — not
    the full "Pełny" no-repeat-ever design (that needs a persistent root
    daemon instead of per-call pkexec), but a real reduction in friction
    with no new code.
  -->
  <vendor>POSMA</vendor>
  <action id="com.posma.broker">
    <description>Wykonaj uprzywilejowaną operację POSMA</description>
    <message>POSMA potrzebuje uprawnień administratora, aby wykonać tę operację</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/posma/linux-broker</annotate>
  </action>
</policyconfig>
