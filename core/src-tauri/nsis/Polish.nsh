; Tauri's own installer messages in Polish; NSIS translates its standard pages itself.
; Wired in through customLanguageFiles in tauri.windows.conf.json.
LangString addOrReinstall ${LANG_POLISH} "Dodaj lub zainstaluj ponownie"
LangString alreadyInstalled ${LANG_POLISH} "Już zainstalowano"
LangString alreadyInstalledLong ${LANG_POLISH} "${PRODUCTNAME} ${VERSION} jest już zainstalowany. Wybierz, co zrobić, i kliknij Dalej."
LangString appRunning ${LANG_POLISH} "${PRODUCTNAME} jest uruchomiony. Zamknij go i spróbuj ponownie."
LangString appRunningOkKill ${LANG_POLISH} "${PRODUCTNAME} jest uruchomiony.$\nKliknij OK, aby go zamknąć."
LangString chooseMaintenanceOption ${LANG_POLISH} "Wybierz, co zrobić z instalacją."
LangString choowHowToInstall ${LANG_POLISH} "Wybierz, jak zainstalować ${PRODUCTNAME}."
LangString createDesktop ${LANG_POLISH} "Utwórz skrót na pulpicie"
LangString dontUninstall ${LANG_POLISH} "Nie odinstalowuj"
LangString dontUninstallDowngrade ${LANG_POLISH} "Nie odinstalowuj (ten instalator nie instaluje starszej wersji bez odinstalowania nowszej)"
LangString failedToKillApp ${LANG_POLISH} "Nie udało się zamknąć ${PRODUCTNAME}. Zamknij go i spróbuj ponownie."
LangString installingWebview2 ${LANG_POLISH} "Instalowanie WebView2..."
LangString newerVersionInstalled ${LANG_POLISH} "Zainstalowana jest nowsza wersja ${PRODUCTNAME}. Instalowanie starszej nie jest zalecane; jeśli naprawdę jej potrzebujesz, najpierw odinstaluj obecną. Wybierz, co zrobić, i kliknij Dalej."
LangString older ${LANG_POLISH} "starsza"
LangString olderOrUnknownVersionInstalled ${LANG_POLISH} "Zainstalowana jest $R4 wersja ${PRODUCTNAME}. Zalecamy odinstalować ją przed instalacją. Wybierz, co zrobić, i kliknij Dalej."
LangString silentDowngrades ${LANG_POLISH} "Ten instalator nie instaluje starszej wersji w trybie cichym. Uruchom go z interfejsem graficznym.$\n"
LangString unableToUninstall ${LANG_POLISH} "Nie udało się odinstalować."
LangString uninstallApp ${LANG_POLISH} "Odinstaluj ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_POLISH} "Odinstaluj przed instalacją"
LangString unknown ${LANG_POLISH} "nieznana"
LangString webview2AbortError ${LANG_POLISH} "Nie udało się zainstalować WebView2, a bez niego aplikacja nie działa. Uruchom instalator ponownie."
LangString webview2DownloadError ${LANG_POLISH} "Błąd: nie udało się pobrać WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_POLISH} "Pobrano instalator WebView2"
LangString webview2Downloading ${LANG_POLISH} "Pobieranie instalatora WebView2..."
LangString webview2InstallError ${LANG_POLISH} "Błąd: instalacja WebView2 zakończyła się kodem $1"
LangString webview2InstallSuccess ${LANG_POLISH} "Zainstalowano WebView2"
LangString deleteAppData ${LANG_POLISH} "Usuń dane aplikacji (ustawienia; sejf zostaje)"
