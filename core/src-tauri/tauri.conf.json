{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "core",
  "version": "0.1.0",
  "identifier": "com.posma.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "POSMA",
        "minWidth": 900,
        "minHeight": 620,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/system-info", "binaries/temp-clean", "binaries/duplicates", "binaries/big-files", "binaries/autostart", "binaries/shredder", "binaries/metadata", "binaries/disk-map", "binaries/browser-hygiene", "binaries/health-monitor", "binaries/uninstaller", "binaries/vault", "binaries/linux-broker", "binaries/journald-trim", "binaries/pkg-cache", "binaries/kernel-mgr", "binaries/grub-editor"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
