{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POSMA",
  "mainBinaryName": "posma",
  "version": "0.3.0",
  "identifier": "com.posma.app",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "POSMA",
        "minWidth": 1600,
        "minHeight": 900,
        "width": 1600,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "externalBin": [
      "binaries/posma-big-files",
      "binaries/posma-browser-hygiene",
      "binaries/posma-disk-map",
      "binaries/posma-duplicates",
      "binaries/posma-health-monitor",
      "binaries/posma-metadata",
      "binaries/posma-shredder",
      "binaries/posma-system-info",
      "binaries/posma-temp-clean",
      "binaries/posma-vault"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
